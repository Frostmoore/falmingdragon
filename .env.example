APP_NAME=FlamingDragon
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (Docker: leave DB_HOST=db) ──────────────────────────────────────
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flamingdragon
DB_USERNAME=flamingdragon
DB_PASSWORD=flamingdragon_secret
DB_ROOT_PASSWORD=flamingdragon_root

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (optional) ───────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@flamingdragon.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── FlamingDragon — Telegram ──────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
FD_TELEGRAM_BOT_TOKEN=
# A random secret string (min 32 chars) used to verify webhook calls
FD_TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram chat IDs allowed to control the bot
# Send /start to your bot, then check https://api.telegram.org/bot<TOKEN>/getUpdates
FD_TELEGRAM_ALLOWED_CHAT_IDS=

# ── FlamingDragon — LLM providers ────────────────────────────────────────────
FD_LLM_DEFAULT_PROVIDER=anthropic
FD_LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001

# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=
# Get your key at platform.openai.com/api-keys
OPENAI_API_KEY=
# Only needed if using Ollama (self-hosted LLM)
FD_OLLAMA_BASE_URL=http://localhost:11434

# ── FlamingDragon — Execution ─────────────────────────────────────────────────
FD_MAX_CONCURRENT_AGENTS=3
FD_DEFAULT_TIMEOUT=300

# ── Docker ────────────────────────────────────────────────────────────────────
# Port to expose the web server on the host (default 80)
APP_PORT=80

# ── Google OAuth2 (shared Client ID/Secret for Calendar + Gmail) ──────────────
# Setup: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar — refresh token with scope: https://www.googleapis.com/auth/calendar
# Use OAuth Playground: https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Gmail — refresh token with scope: https://www.googleapis.com/auth/gmail.modify
# Can be the same token as above if both scopes were requested together
GOOGLE_GMAIL_REFRESH_TOKEN=

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
# Setup: https://developers.facebook.com → App → WhatsApp → Getting Started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Facebook / Instagram (Meta Graph API) ────────────────────────────────────
# Setup: https://developers.facebook.com → Graph API Explorer → Get Page Access Token
# Permissions: pages_manage_posts, instagram_content_publish, instagram_basic
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
